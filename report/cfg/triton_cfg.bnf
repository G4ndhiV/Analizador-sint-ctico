% =============================================================================
% CFG COMPLETA - Analizador sintactico Triton (.tri) - Equipo 11
% Fuente canonica de implementacion: parser/parser.y (reglas entre %% ... %%)
% Simbolo inicial: program
% No terminales: 36 | Producciones (alternativas): 105 | Ultima revision: 2026-06
% Notacion: NT -> cuerpo   (una alternativa por linea con prefijo P-NNN)
% epsilon = produccion vacia (/* empty */ en yacc)
% =============================================================================

% -----------------------------------------------------------------------------
% 1. PROGRAMA Y ESTRUCTURA DE BLOQUES
% -----------------------------------------------------------------------------

P-001  program           -> opt_newlines top_block opt_newlines

P-002  opt_newlines      -> epsilon
P-003  opt_newlines      -> opt_newlines TOKEN_NEWLINE

P-004  top_block         -> epsilon
P-005  top_block         -> top_block opt_newlines top_line

P-006  top_line          -> import_stmt
P-007  top_line          -> import_stmt TOKEN_NEWLINE
P-008  top_line          -> def_stmt
P-009  top_line          -> def_stmt TOKEN_NEWLINE

P-010  suite             -> simple_stmt
P-011  suite             -> opt_newlines TOKEN_INDENT block_body TOKEN_DEDENT

P-012  block_body        -> epsilon
P-013  block_body        -> block_body opt_newlines block_stmt

P-014  block_stmt        -> stmt TOKEN_NEWLINE
P-015  block_stmt        -> stmt

P-016  simple_stmt       -> stmt

% -----------------------------------------------------------------------------
% 2. SENTENCIAS (stmt y derivados)
% -----------------------------------------------------------------------------

P-017  stmt              -> import_stmt
P-018  stmt              -> def_stmt
P-019  stmt              -> assign_stmt
P-020  stmt              -> ident_stmt
P-021  stmt              -> if_stmt
P-022  stmt              -> while_stmt
P-023  stmt              -> for_stmt
P-024  stmt              -> return_stmt
P-025  stmt              -> pass_stmt
P-026  stmt              -> expr_stmt

P-027  import_stmt       -> KW_IMPORT import_name opt_as

P-028  import_name       -> TOKEN_IDENTIFIER
P-029  import_name       -> import_name '.' TOKEN_IDENTIFIER

P-030  opt_as            -> epsilon
P-031  opt_as            -> KW_AS TOKEN_IDENTIFIER

P-032  triton_decorator  -> '@' TOKEN_IDENTIFIER '.' TOKEN_IDENTIFIER

P-033  opt_triton_decorator -> epsilon
P-034  opt_triton_decorator -> triton_decorator opt_newlines

P-035  def_stmt          -> opt_triton_decorator KW_DEF TOKEN_IDENTIFIER '(' param_list_opt ')' ':' suite

P-036  assign_stmt       -> TOKEN_IDENTIFIER ':' expr TOKEN_ASSIGN expr

P-037  ident_stmt        -> TOKEN_IDENTIFIER ident_op

P-038  ident_op          -> TOKEN_ASSIGN expr
P-039  ident_op          -> ident_suffix

P-040  if_stmt           -> KW_IF expr ':' suite elif_parts else_part

P-041  elif_parts        -> epsilon
P-042  elif_parts        -> elif_parts KW_ELIF expr ':' suite

P-043  else_part         -> epsilon
P-044  else_part         -> KW_ELSE ':' suite

P-045  while_stmt        -> KW_WHILE expr ':' suite

P-046  for_stmt          -> KW_FOR TOKEN_IDENTIFIER KW_IN expr ':' suite

P-047  return_stmt       -> KW_RETURN expr
P-048  return_stmt       -> KW_RETURN

P-049  pass_stmt         -> KW_PASS

P-050  expr_stmt         -> expr

% -----------------------------------------------------------------------------
% 3. PARAMETROS DE FUNCION
% -----------------------------------------------------------------------------

P-051  param_list_opt    -> epsilon
P-052  param_list_opt    -> param_list

P-053  param_list        -> param
P-054  param_list        -> param_list opt_newlines ',' opt_newlines param

P-055  param             -> TOKEN_IDENTIFIER
P-056  param             -> TOKEN_IDENTIFIER ':' opt_newlines expr

% -----------------------------------------------------------------------------
% 4. SUFIJOS DE IDENTIFICADOR Y EXPRESIONES
% -----------------------------------------------------------------------------

P-057  ident_suffix      -> member_chain ident_suffix
P-058  ident_suffix      -> '[' subscript_list ']' ident_suffix
P-059  ident_suffix      -> '(' opt_newlines arg_list_opt opt_newlines ')' ident_suffix
P-060  ident_suffix      -> TOKEN_OPERATOR opt_newlines expr
P-061  ident_suffix      -> KW_IS expr
P-062  ident_suffix      -> KW_IF expr KW_ELSE expr
P-063  ident_suffix      -> TOKEN_DELIMITER opt_newlines expr
P-064  ident_suffix      -> epsilon

P-065  expr              -> TOKEN_INTEGER
P-066  expr              -> TOKEN_FLOAT
P-067  expr              -> TOKEN_STRING
P-068  expr              -> TOKEN_IDENTIFIER ident_suffix
P-069  expr              -> KW_NONE
P-070  expr              -> KW_TRUE
P-071  expr              -> KW_FALSE
P-072  expr              -> expr TOKEN_OPERATOR opt_newlines expr
P-073  expr              -> expr KW_IS expr
P-074  expr              -> expr KW_IF expr KW_ELSE expr
P-075  expr              -> expr TOKEN_DELIMITER opt_newlines expr
P-076  expr              -> '(' opt_newlines arg_list_opt opt_newlines ')'
P-077  expr              -> list_expr
P-078  expr              -> expr '[' subscript_list ']'
P-079  expr              -> call_expr
P-080  expr              -> unary_expr

P-081  opt_expr          -> epsilon
P-082  opt_expr          -> expr

P-083  subscript_list    -> subscript
P-084  subscript_list    -> subscript_list ',' subscript

P-085  subscript         -> expr
P-086  subscript         -> KW_NONE
P-087  subscript         -> ':' opt_expr
P-088  subscript         -> opt_expr ':' opt_expr
P-089  subscript         -> opt_expr ':' opt_expr ':' opt_expr

P-090  unary_expr        -> TOKEN_OPERATOR expr

P-091  list_expr         -> '[' opt_newlines arg_list_opt opt_newlines ']'

P-092  member_chain      -> '.' opt_newlines TOKEN_IDENTIFIER
P-093  member_chain      -> member_chain '.' opt_newlines TOKEN_IDENTIFIER
P-094  member_chain      -> TOKEN_DELIMITER opt_newlines TOKEN_IDENTIFIER
P-095  member_chain      -> member_chain TOKEN_DELIMITER opt_newlines TOKEN_IDENTIFIER

P-096  call_expr         -> TOKEN_IDENTIFIER '(' opt_newlines arg_list_opt opt_newlines ')'
P-097  call_expr         -> TOKEN_IDENTIFIER member_chain '(' opt_newlines arg_list_opt opt_newlines ')'
P-098  call_expr         -> TOKEN_IDENTIFIER '(' opt_newlines ')'
P-099  call_expr         -> call_expr '.' TOKEN_IDENTIFIER '(' opt_newlines arg_list_opt opt_newlines ')'

P-100  arg_list_opt      -> epsilon
P-101  arg_list_opt      -> arg_list

P-102  arg_list          -> arg
P-103  arg_list          -> arg_list ',' opt_newlines arg

P-104  arg               -> expr
P-105  arg               -> TOKEN_IDENTIFIER TOKEN_ASSIGN opt_newlines expr

% =============================================================================
% TERMINALES ADICIONALES
% =============================================================================
% TOKEN_ASSIGN - asignacion (=) separada de TOKEN_OPERATOR
% KW_IS - operador is (comparacion de identidad)
% Acciones semanticas (fuera de CFG):
%   validate_stmt_line_end() en block_stmt sin NEWLINE
%   lexer_multistmt_error() en yylex wrapper
%   bol_dedent_token() para DEDENT en columna 0
